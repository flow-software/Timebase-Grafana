    {
      "id": 16,
      "type": "table",
      "datasource": {
        "type": "flowsoftware-timebaseatlas-datasource",
        "uid": "atlas-dev"
      },
      "title": "CNC machines now in ${mode:text}",
      "description": "Cypher filtered by $mode, an Enumeration members variable on ControllerModeEnum: labels in the dropdown, keys sent as numbers.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 115
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "flowsoftware-timebaseatlas-datasource",
            "uid": "atlas-dev"
          },
          "queryType": "cypher",
          "format": "table",
          "cypher": "// Machines whose controller is in one of the modes picked in $mode (an Enumeration members variable).\nMATCH (n:CNCProduction) WHERE n.ControllerMode.Value IN $mode\nRETURN n.entityId AS machine, n.ControllerMode.Value AS mode\nORDER BY machine"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mode"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Automatic",
                        "index": 0
                      },
                      "2": {
                        "text": "Manual",
                        "index": 1
                      },
                      "3": {
                        "text": "MDI",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
