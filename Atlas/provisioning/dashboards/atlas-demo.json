        "h": 8,
        "w": 24,
        "x": 0,
        "y": 78
      },
      "id": 10,
      "targets": [
        {
          "cypher": "MATCH (n:CNCProduction) WHERE n.entityId = \"CNC01-Production\"\nUNWIND n.SpindleTemp AS v\nWITH n, v WHERE v.Timestamp >= datetime($from) AND v.Timestamp < datetime($to)\nRETURN v.Timestamp AS time, v.Value AS SpindleTemp ORDER BY time",
          "datasource": {
            "type": "flowsoftware-timebaseatlas-datasource",
            "uid": "atlas-dev"
          },
          "format": "table",
          "queryType": "cypher",
          "refId": "A"
        }
      ],
      "title": "History via Cypher ($from/$to from the time picker)",
      "type": "timeseries"
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Status: job, program and alarm on $machines",
      "description": "Data > Trend, Raw, of JobNumber, Program and AlarmActive of every CNCProduction under $machines (picked in the Select modal under the $machines variable).",
      "datasource": {
        "type": "flowsoftware-timebaseatlas-datasource",
        "uid": "atlas-dev"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 86
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "flowsoftware-timebaseatlas-datasource",
            "uid": "atlas-dev"
          },
          "queryType": "history",
          "aggregation": "raw",
          "selection": [
            {
              "instance": "$machines",
              "scope": "nested",
              "nestedType": "CNCProduction",
              "property": "JobNumber"
            },
            {
              "instance": "$machines",
              "scope": "nested",
              "nestedType": "CNCProduction",
              "property": "Program"
            },
            {
              "instance": "$machines",
              "scope": "nested",
              "nestedType": "CNCProduction",
              "property": "AlarmActive"
            }
          ]
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*AlarmActive"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Alarm",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Program"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Program 1",
                        "color": "#31AEE4",
                        "index": 1
                      },
                      "2": {
                        "text": "Program 2",
                        "color": "#34D399",
                        "index": 2
                      },
                      "3": {
                        "text": "Program 3",
                        "color": "#F59E0B",
                        "index": 3
                      },
                      "4": {
                        "text": "Program 4",
                        "color": "#4CD6F5",
                        "index": 4
                      },
                      "5": {
                        "text": "Program 5",
                        "color": "#1B81AD",
                        "index": 5
                      },
                      "6": {
                        "text": "Program 6",
                        "color": "#06624E",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
