{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Timebase Historian",
  "id": "flowsoftware-timebasehistorian-datasource",
  "metrics": true,
  "alerting": true,
  "streaming": true,
  "backend": true,
  "executable": "gpx_timebase",
  "info": {
    "description": "Query tag history from the Timebase Historian through its native API or the i3X standard API, with automatic OAuth token renewal and Grafana alerting.",
    "author": {
      "name": "Flow Software",
      "url": "https://www.flow-software.com"
    },
    "keywords": ["datasource", "timebase", "i3x", "historian", "industrial", "iiot", "time series"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "Timebase", "url": "https://timebase.flow-software.com" }
    ],
    "screenshots": [
      { "name": "Dashboard", "path": "img/screenshots/dashboard.png" },
      { "name": "Tree browser with field filters", "path": "img/screenshots/tree-browser.png" },
      { "name": "Data source settings", "path": "img/screenshots/config.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
